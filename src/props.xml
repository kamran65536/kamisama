<Project>
	<PropertyGroup>
		<RootNamespace>$(MSBuildProjectName.Replace(".Abstractions", "").Replace(".Services", "").Replace(".Tests", "").Replace(".Http", "").Replace(".Core", "").Replace(".Sqlite", "").Replace(".Oracle", "").Replace(".SqlServer", "").Replace(".Postgresql", ""))</RootNamespace>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DebugType>Full</DebugType>
		<Version>10.0.13</Version>
		<PackageProjectUrl>https://gitlab.com/kamran65536/KamiSama</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/kamran65536/KamiSama</RepositoryUrl>
		<Authors>Kamran Fallah</Authors>
		<Company>-</Company>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile Condition="'$(PackageDocumentationRoot)' != '' and Exists('$(MSBuildProjectDirectory)/$(PackageDocumentationRoot)/index.md')">README.md</PackageReadmeFile>
		<PackageIcon>logo.png</PackageIcon>
		<TreatWarningsAsErrors>true</TreatWarningsAsErrors>
		<ImplicitUsings>true</ImplicitUsings>
		<NoWarn>1701;1702;CA1862;CA1859;CA1822;CA1873;NU1900;NETSDK1057</NoWarn>
	</PropertyGroup>
	<ItemGroup>
		<None Include="$(MSBuildProjectDirectory)/$(PackageDocumentationRoot)/index.md"
			  Pack="true"
			  PackagePath="README.md"
			  Condition="'$(PackageDocumentationRoot)' != '' and Exists('$(MSBuildProjectDirectory)/$(PackageDocumentationRoot)/index.md')" />
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\logo.png">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
	</ItemGroup>
</Project>
