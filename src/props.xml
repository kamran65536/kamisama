<Project>
	<PropertyGroup>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<DebugType>Full</DebugType>
		<Version>2.8.4</Version>
		<PackageProjectUrl>https://gitlab.com/kamran65536/KamiSama</PackageProjectUrl>
		<RepositoryUrl>https://gitlab.com/kamran65536/KamiSama</RepositoryUrl>
		<Authors>Kamran Fallah</Authors>
		<Company>-</Company>
		<TargetFramework>net8.0</TargetFramework>
		<Nullable>enable</Nullable>
		<PackageLicenseFile>LICENSE</PackageLicenseFile>
		<PackageReadmeFile>readme.md</PackageReadmeFile>
		<ApplicationIcon>KamiSama.ico</ApplicationIcon>
		<PackageIcon>KamiSama-logo-small.png</PackageIcon>
	</PropertyGroup>
	<ItemGroup>
		<None Include="..\LICENSE">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\readme.md">
			<Pack>True</Pack>
			<PackagePath>\</PackagePath>
		</None>
		<None Include="..\..\docs\*">
			<Pack>True</Pack>
			<PackagePath>\docs\</PackagePath>
		</None>
	</ItemGroup>
</Project>