<Project Sdk="Microsoft.NET.Sdk">

	<Import Project="../props-test.xml" />

	<ItemGroup>
		<Folder Include="Resources\" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\Core\KamiSama.Extensions.Core.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
	  <PackageReference Update="coverlet.collector" Version="6.0.4" />
	  <PackageReference Update="Microsoft.NET.Test.Sdk" Version="17.14.1" />
	  <PackageReference Update="MSTest.TestAdapter" Version="3.9.3" />
	  <PackageReference Update="MSTest.TestFramework" Version="3.9.3" />
	  <PackageReference Update="NSubstitute" Version="5.3.0" />
	</ItemGroup>

</Project>
