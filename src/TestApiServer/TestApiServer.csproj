		<ProjectReference Include="..\KamiSama.Modules.Locations.Sqlite\KamiSama.Modules.Locations.Sqlite.csproj" />
		<ProjectReference Include="..\KamiSama.Modules.Otp.Postgresql\KamiSama.Modules.Otp.Postgresql.csproj" />
		<ProjectReference Include="..\KamiSama.Modules.Otp.Sqlite\KamiSama.Modules.Otp.Sqlite.csproj" />
