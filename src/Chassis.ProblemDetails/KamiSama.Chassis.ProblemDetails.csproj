<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageDocumentationRoot>../../docs/content/api/chassis-problemdetails</PackageDocumentationRoot>
	</PropertyGroup>
	<Import Project="../props.xml" />
	<PropertyGroup>
		<Description>ASP.NET Core ProblemDetails integration for converting KamiSama HTTP exceptions into standardized API error responses.</Description>
	</PropertyGroup>
	<ItemGroup>
	  <None Remove="KamiSama.ico" />
	</ItemGroup>
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<ProjectReference Include="..\Chassis.Exceptions\KamiSama.Chassis.HttpExceptions.csproj" />
	</ItemGroup>
	<ItemGroup>
	  <_DeploymentManifestIconFile Remove="KamiSama.ico" />
	</ItemGroup>
	<ItemGroup>
	  <Compile Update="Properties\Resources.Designer.cs">
	    <DesignTime>True</DesignTime>
	    <AutoGen>True</AutoGen>
	    <DependentUpon>Resources.resx</DependentUpon>
	    <NoWarn>$(NoWarn);1591</NoWarn>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
	  <EmbeddedResource Update="Properties\Resources.resx">
	    <Generator>ResXFileCodeGenerator</Generator>
	    <LastGenOutput>Resources.Designer.cs</LastGenOutput>
	  </EmbeddedResource>
	</ItemGroup>
</Project>
