{
  "$schema": "http://json.schemastore.org/template",
  "author": "KamiSama",
  "identity": "KamiSama.Templates.BoundedContext",
  "name": "KamiSama Bounded Context",
  "shortName": "kamisama-bounded-context",
  "sourceName": "Example",
  "preferNameDirectory": true,
  "classifications": [ "DDD", "Library", "KamiSama" ],
  "tags": { "language": "C#", "type": "solution" },
  "symbols": {
    "UseProps": { "type": "parameter", "dataType": "bool", "defaultValue": "false" },
    "PropsPath": { "type": "parameter", "dataType": "string", "defaultValue": "../props.xml", "isEnabled": "UseProps", "replaces": "PropsPathToken" },
    "IncludeExample": { "type": "parameter", "dataType": "bool", "defaultValue": "false", "description": "Include a sample contract and attributed implementation." }
  },
  "sources": [ {
    "modifiers": [ { "condition": "(!IncludeExample)", "exclude": [ "**/Examples/**" ] } ]
  } ]
}
