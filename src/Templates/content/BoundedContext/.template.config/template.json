{
  "$schema": "http://json.schemastore.org/template",
  "author": "KamiSama",
  "identity": "KamiSama.Templates.BoundedContext.V2",
  "name": "KamiSama Bounded Context Projects",
  "shortName": "kamisama-bc",
  "sourceName": "Example",
  "preferNameDirectory": false,
  "classifications": [ "DDD", "Library", "KamiSama" ],
  "tags": { "language": "C#", "type": "project" },
  "symbols": {
    "Context": { "type": "parameter", "dataType": "string", "isRequired": true, "replaces": "ContextToken", "fileRename": "ContextToken", "description": "Bounded-context name." },
    "UseProps": { "type": "parameter", "dataType": "bool", "defaultValue": "false" },
    "PropsPath": { "type": "parameter", "dataType": "string", "defaultValue": "../props.xml", "isEnabled": "UseProps", "replaces": "PropsPathToken" }
  },
  "primaryOutputs": [
    { "path": "Example.ContextToken.Abstractions/Example.ContextToken.Abstractions.csproj" },
    { "path": "Example.ContextToken.Core/Example.ContextToken.Core.csproj" }
  ]
}
