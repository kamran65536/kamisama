@page "/settings/users"
@using Suma.AdminPanel.Services.Users

@inject IListUsers ListUsersService
@inject IDisableUser DisableUserService
@inject IEnableUser EnableUserService
@inject SafeRunner SafeRunner

<PageTitle>@localizer["Users"]</PageTitle>

<h1>@localizer["Users"]</h1>

<SearchBox OnSearchClicked="() => grid!.RefreshDataAsync(CancellationToken.None)">
	<div class="row g-2">
		<div class="col-md-6">
			<TextInput @bind-Value="searchUsername" Placeholder="@localizer[nameof(Resources.Username)]" />
		</div>
		<div class="col-md-6">
			<TextInput @bind-Value="searchEmail" Placeholder="@localizer[nameof(Resources.Email)]" />
		</div>
	</div>
</SearchBox>

<div class="d-flex justify-content-end mb-2">
	<Button Type="ButtonType.Link" Color="ButtonColor.Primary" To="/settings/users/save">
		<Icon Name="IconName.PlusCircleFill" Class="me-1" />
		@localizer["Add"]
	</Button>
</div>

<CustomGrid TItem="UserListItemDto"
			@ref="grid"
			DataProvider="UsersDataProvider"
			RowKeySelector="x => x.Id">
	<CustomGridColumn TItem="UserListItemDto" HeaderText="@localizer[nameof(Resources.Username)]">
		<CopyableLabel Value="@context.Username" />
	</CustomGridColumn>
	<CustomGridColumn TItem="UserListItemDto" HeaderText="@localizer[nameof(Resources.Email)]">
		<CopyableLabel Value="@context.Email" />
	</CustomGridColumn>
	<CustomGridColumn TItem="UserListItemDto" HeaderText="@localizer["Roles"]">
		@string.Join(", ", context.Roles)
	</CustomGridColumn>
	<CustomGridColumn TItem="UserListItemDto" ColumnClass="@(x => "col-3")">
		@if (!context.IsEditable)
		{
			@if (context.IsEnabled)
			{
				<Icon Name="IconName.CheckSquareFill" Size="IconSize.x5" Class="color-green-100" />
			}
			else
			{
				<Icon Name="IconName.XSquareFill" Size="IconSize.x5" Class="color-red-100" />
			}
			<small class="ms-3">@localizer["NotEditable"]</small>
		}
		else
		{
			@if (context.IsEnabled)
			{
				<Button @onclick="() => DisableUser(context.Id)">
					<Icon Name="IconName.CheckSquareFill" Size="IconSize.x5" Class="color-green-900" />
				</Button>
			}
			else
			{
				<Button @onclick="() => EnableUser(context.Id)">
					<Icon Name="IconName.XSquareFill" Size="IconSize.x5" Class="color-red-900" />
				</Button>
			}
			<Button Type="ButtonType.Link" Class="p-0 me-2" To="@($"/settings/users/save/{context.Id}")">
				<Icon Name="IconName.JournalText" Size="IconSize.x5" Class="color-orange-900" />
			</Button>
			<Button Type="ButtonType.Link" Class="p-0" To="@($"/settings/users/details/{context.Id}")">
				<Icon Name="IconName.Eye" Size="IconSize.x5" Class="color-blue-900" />
			</Button>
		}
	</CustomGridColumn>
</CustomGrid>

@code {
	private CustomGrid<UserListItemDto>? grid;
	private string? searchUsername;
	private string? searchEmail;

	private async Task<GridDataProviderResult<UserListItemDto>> UsersDataProvider(GridDataProviderRequest<UserListItemDto> request)
	{
		var searchModel = UserSearchModel.All with
		{
			Page = request.PageNumber,
			PageSize = request.PageSize,
			Username = searchUsername,
			Email = searchEmail,
			OrderBy = default,
		};

		var result = await ListUsersService.ListAsync(searchModel, CancellationToken.None);

		return new GridDataProviderResult<UserListItemDto>
		{
			Data = result.Items,
			TotalCount = result.TotalItemsCount,
		};
	}

	private async Task DisableUser(Guid userId)
	{
		var isSuccess = await SafeRunner.RunSafeAsync(async () =>
		{
			await DisableUserService.DisableAsync(userId, CancellationToken.None);
		});

		if (isSuccess)
			await grid!.RefreshDataAsync(CancellationToken.None);
	}

	private async Task EnableUser(Guid userId)
	{
		var isSuccess = await SafeRunner.RunSafeAsync(async () =>
		{
			await EnableUserService.EnableAsync(userId, CancellationToken.None);
		});

		if (isSuccess)
			await grid!.RefreshDataAsync(CancellationToken.None);
	}
}

