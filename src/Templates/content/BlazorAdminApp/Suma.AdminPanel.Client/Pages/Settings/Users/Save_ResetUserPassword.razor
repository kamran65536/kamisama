@using Suma.AdminPanel.Services.Users

<div class="row mb-3">
	<div class="col">
		<label for="password" class="form-label">@localizer["Password"]</label>
		<PasswordInput Id="password" Class="form-control" @bind-Value="password" />
	</div>
</div>
<div class="row mb-3">
	<div class="col">
		<label for="confirmPassword" class="form-label">@localizer["ConfirmPassword"]</label>
		<PasswordInput Id="confirmPassword" Class="form-control" @bind-Value="confirmPassword" />
	</div>
</div>
<div class="row mb-3">
	<div class="col">
		<Button Color="ButtonColor.Primary" Type="ButtonType.Button" @onclick="ResetButtonClicked">
			<Icon Name="IconName.Key" Color="IconColor.White" />
			@localizer["Reset"]
		</Button>
	</div>
</div>
@if (!string.IsNullOrWhiteSpace(errorMessage))
{
	<div class="row mb-3">
		<div class="col">
			<Alert Color="AlertColor.Danger">
				<Icon Name="IconName.ExclamationTriangleFill" Class="me-2" />
				@errorMessage
			</Alert>
		</div>
	</div>
}

@code {
	private string password = string.Empty;
	private string confirmPassword = string.Empty;
	private string errorMessage = string.Empty;

	[Parameter]
	public UserDto? User { get; set; }

	[Parameter]
	public EventCallback<ResetUserPasswordRequest> OnResetPasswordClicked { get; set; }

	private async Task ResetButtonClicked()
	{
		errorMessage = string.Empty;

		if (User is null)
			return;

		if (string.IsNullOrWhiteSpace(password))
		{
			errorMessage = localizer["Password is required."];
			return;
		}

		if (string.IsNullOrWhiteSpace(confirmPassword))
		{
			errorMessage = localizer["Confirm password is required."];
			return;
		}

		if (password != confirmPassword)
		{
			errorMessage = localizer["Password and confirm password do not match."];
			return;
		}

		await OnResetPasswordClicked.InvokeAsync(new ResetUserPasswordRequest(User.Id, password));
	}
}

