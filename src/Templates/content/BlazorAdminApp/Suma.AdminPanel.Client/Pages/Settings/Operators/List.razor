@page "/settings/operators"
@using Suma.AdminPanel.Services.Operators

@inject IListOperators ListOperatorsService
@inject IDisableOperator DisableOperatorService
@inject IEnableOperator EnableOperatorService
@inject SafeRunner SafeRunner

<PageTitle>@localizer["Operators"]</PageTitle>

<h1>@localizer["Operators"]</h1>

<SearchBox OnSearchClicked="() => grid!.RefreshDataAsync(CancellationToken.None)">
	<div class="row g-2">
		<div class="col-md-6">
			<TextInput @bind-Value="searchUsername" Placeholder="@localizer[nameof(Resources.Username)]" />
		</div>
		<div class="col-md-6">
			<TextInput @bind-Value="searchEmail" Placeholder="@localizer[nameof(Resources.Email)]" />
		</div>
	</div>
</SearchBox>

<div class="d-flex justify-content-end mb-2">
	<Button Type="ButtonType.Link" Color="ButtonColor.Primary" To="/settings/operators/save">
		<Icon Name="IconName.PlusCircleFill" Class="me-1" />
		@localizer["Add"]
	</Button>
</div>

<CustomGrid TItem="OperatorListItemDto"
			@ref="grid"
			DataProvider="OperatorsDataProvider"
			RowKeySelector="x => x.Id">
	<CustomGridColumn TItem="OperatorListItemDto" HeaderText="@localizer[nameof(Resources.Username)]">
		<CopyableLabel Value="@context.Username" />
	</CustomGridColumn>
	<CustomGridColumn TItem="OperatorListItemDto" HeaderText="@localizer[nameof(Resources.Email)]">
		<CopyableLabel Value="@context.Email" />
	</CustomGridColumn>
	<CustomGridColumn TItem="OperatorListItemDto" HeaderText="@localizer["Roles"]">
		@string.Join(", ", context.Roles)
	</CustomGridColumn>
	<CustomGridColumn TItem="OperatorListItemDto" ColumnClass="@(x => "col-3")">
		@if (!context.IsEditable)
		{
			@if (context.IsEnabled)
			{
				<Icon Name="IconName.CheckSquareFill" Size="IconSize.x5" Class="color-green-100" />
			}
			else
			{
				<Icon Name="IconName.XSquareFill" Size="IconSize.x5" Class="color-red-100" />
			}
			<small class="ms-3">@localizer["NotEditable"]</small>
		}
		else
		{
			@if (context.IsEnabled)
			{
				<Button @onclick="() => DisableOperator(context.Id)">
					<Icon Name="IconName.CheckSquareFill" Size="IconSize.x5" Class="color-green-900" />
				</Button>
			}
			else
			{
				<Button @onclick="() => EnableOperator(context.Id)">
					<Icon Name="IconName.XSquareFill" Size="IconSize.x5" Class="color-red-900" />
				</Button>
			}
			<Button Type="ButtonType.Link" Class="p-0 me-2" To="@($"/settings/operators/save/{context.Id}")">
				<Icon Name="IconName.JournalText" Size="IconSize.x5" Class="color-orange-900" />
			</Button>
			<Button Type="ButtonType.Link" Class="p-0" To="@($"/settings/operators/details/{context.Id}")">
				<Icon Name="IconName.Eye" Size="IconSize.x5" Class="color-blue-900" />
			</Button>
		}
	</CustomGridColumn>
</CustomGrid>

@code {
	private CustomGrid<OperatorListItemDto>? grid;
	private string? searchUsername;
	private string? searchEmail;

	private async Task<GridDataProviderResult<OperatorListItemDto>> OperatorsDataProvider(GridDataProviderRequest<OperatorListItemDto> request)
	{
		var searchModel = OperatorSearchModel.All with
		{
			Page = request.PageNumber,
			PageSize = request.PageSize,
			Username = searchUsername,
			Email = searchEmail,
			OrderBy = default,
		};

		var result = await ListOperatorsService.ListAsync(searchModel, CancellationToken.None);

		return new GridDataProviderResult<OperatorListItemDto>
		{
			Data = result.Items,
			TotalCount = result.TotalItemsCount,
		};
	}

	private async Task DisableOperator(Guid operatorId)
	{
		var isSuccess = await SafeRunner.RunSafeAsync(async () =>
		{
			await DisableOperatorService.DisableAsync(operatorId, CancellationToken.None);
		});

		if (isSuccess)
			await grid!.RefreshDataAsync(CancellationToken.None);
	}

	private async Task EnableOperator(Guid operatorId)
	{
		var isSuccess = await SafeRunner.RunSafeAsync(async () =>
		{
			await EnableOperatorService.EnableAsync(operatorId, CancellationToken.None);
		});

		if (isSuccess)
			await grid!.RefreshDataAsync(CancellationToken.None);
	}
}
