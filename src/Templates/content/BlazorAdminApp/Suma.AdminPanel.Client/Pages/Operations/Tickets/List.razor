@page "/operations/tickets"
@using Suma.AdminPanel.Services.Tickets

@inject IListTickets ListTicketsService

<PageTitle>@localizer["Tickets"]</PageTitle>

<PageHeader Title='@localizer["Tickets"]' Icon="IconName.TicketDetailed" />

<SearchBox OnSearchClicked="() => grid!.RefreshDataAsync(CancellationToken.None)">
	<div class="row g-2">
		<div class="col-md-3">
			<TextInput @bind-Value="searchId" Placeholder="@localizer["TicketId"]" />
		</div>
		<div class="col-md-3">
			<TextInput @bind-Value="searchTitle" Placeholder="@localizer["Subject"]" />
		</div>
		<div class="col-md-3">
			<EnumInput TEnum="TicketingStatus" @bind-Text="searchStatus" />
		</div>
		<div class="col-md-3">
			<EnumInput TEnum="TicketPriority" @bind-Text="searchPriority" />
		</div>
	</div>
</SearchBox>

<CustomGrid TItem="TicketListItemDto"
			@ref="grid"
			DataProvider="TicketsDataProvider"
			RowKeySelector="x => x.TicketId">
	<CustomGridColumn TItem="TicketListItemDto" HeaderText="@localizer["TicketId"]"><CopyableLabel Value="@context.TicketId.ToString()" /></CustomGridColumn>
	<CustomGridColumn TItem="TicketListItemDto" HeaderText="@localizer["Subject"]">@context.Subject</CustomGridColumn>
	<CustomGridColumn TItem="TicketListItemDto" HeaderText="@localizer[nameof(Resources.DateTime)]">@FormatDateTime(context.DateTime)</CustomGridColumn>
	<CustomGridColumn TItem="TicketListItemDto" HeaderText="@localizer[nameof(Resources.Status)]">
		<span class="badge @GetStatusBadgeClass(context.Status)">@localizer[context.Status.ToString()]</span>
	</CustomGridColumn>
	<CustomGridColumn TItem="TicketListItemDto" HeaderText="@localizer["Actions"]" ColumnClass="@(x => "col-1")">
		<Button Type="ButtonType.Link" Class="p-0" To="@($"/operations/tickets/details/{context.TicketId}")">
			<Icon Name="IconName.Eye" Size="IconSize.x5" Class="color-blue-900" />
		</Button>
	</CustomGridColumn>
</CustomGrid>

@code {
	private CustomGrid<TicketListItemDto>? grid;
	private string? searchId;
	private string? searchTitle;
	private string? searchStatus;
	private string? searchPriority;

	private async Task<GridDataProviderResult<TicketListItemDto>> TicketsDataProvider(GridDataProviderRequest<TicketListItemDto> request)
	{
		var status = Enum.TryParse<TicketingStatus>(searchStatus, true, out var parsedStatus) ? parsedStatus : default(TicketingStatus?);
		var priority = Enum.TryParse<TicketPriority>(searchPriority, true, out var parsedPriority) ? parsedPriority : default(TicketPriority?);

		var searchModel = TicketSearchModel.All with
		{
			Page = request.PageNumber,
			PageSize = request.PageSize,
			Id = searchId,
			Title = searchTitle,
			Statuses = status is null ? null : [status.Value],
			Priorities = priority is null ? null : [priority.Value],
			OrderBy = default,
		};

		var result = await ListTicketsService.ListAsync(searchModel, CancellationToken.None);

		return new GridDataProviderResult<TicketListItemDto>
		{
			Data = result.Items,
			TotalCount = result.TotalItemsCount,
		};
	}

	private static string FormatDateTime(DateTime value)
		=> value.ToString("yyyy-MM-dd HH:mm");

	private static string GetStatusBadgeClass(TicketingStatus status)
		=> status switch
		{
			TicketingStatus.Resolved => "text-bg-success",
			TicketingStatus.Closed => "text-bg-secondary",
			TicketingStatus.Reopened => "text-bg-warning",
			_ => "text-bg-info",
		};
}

