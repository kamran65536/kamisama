@implements IAsyncDisposable
@inject IJSRuntime JSRuntime
@inject ToastService ToastService

@if (HasLabel)
{
	<span class="fw-semibold me-1">@Label:</span>
}

<span class="@ContainerClass">
	<span class="@ValueClass">@DisplayValue</span>
	<span class="position-relative d-inline-flex align-items-center">
		<button type="button"
				class="btn btn-link p-0 text-body text-decoration-none"
				title="@CopyButtonTitle"
				aria-label="@CopyButtonTitle"
				disabled="@(!HasValue)"
				@onclick="CopyAsync">
			<Icon Name="IconName.Copy" />
		</button>
		@if (showCopiedIndicator)
		{
			<span class="position-absolute top-50 start-100 translate-middle-y ms-2 badge text-bg-dark text-nowrap">
				@localizer["Copied"]
			</span>
		}
	</span>
</span>

@code {
	private IJSObjectReference? module;
	private CancellationTokenSource? copiedIndicatorCts;
	private bool showCopiedIndicator;

	[Parameter]
	public string? Label { get; set; }

	[Parameter]
	public string? Value { get; set; }

	[Parameter]
	public string EmptyText { get; set; } = "-";

	[Parameter]
	public bool Multiline { get; set; }

	private bool HasLabel => !string.IsNullOrWhiteSpace(Label);
	private bool HasValue => !string.IsNullOrWhiteSpace(Value);
	private string DisplayValue => HasValue ? Value! : EmptyText;
	private string ContainerClass => Multiline
		? "d-flex align-items-start gap-2"
		: "d-inline-flex align-items-center gap-1 mw-100";
	private string ValueClass => Multiline
		? "text-break"
		: "text-break user-select-all";
	private string CopyButtonTitle => localizer["Copy"];

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (!firstRender)
			return;

		module = await JSRuntime.InvokeAsync<IJSObjectReference>(
			"import",
			"./Components/CopyableLabel.razor.js");
	}

	private async Task CopyAsync()
	{
		if (!HasValue)
			return;

		try
		{
			module ??= await JSRuntime.InvokeAsync<IJSObjectReference>(
				"import",
				"./Components/CopyableLabel.razor.js");

			await module.InvokeVoidAsync("copyToClipboard", Value);
			await ShowCopiedIndicatorAsync();
		}
		catch (Exception ex)
		{
			ToastService.Notify(new ToastMessage
			{
				AutoHide = true,
				IconName = IconName.ExclamationTriangleFill,
				Title = localizer[nameof(Resources.Error)],
				Message = ex.Message,
				Type = ToastType.Danger
			});
		}
	}

	private async Task ShowCopiedIndicatorAsync()
	{
		copiedIndicatorCts?.Cancel();
		copiedIndicatorCts?.Dispose();
		copiedIndicatorCts = new();

		showCopiedIndicator = true;
		await InvokeAsync(StateHasChanged);

		try
		{
			await Task.Delay(800, copiedIndicatorCts.Token);
		}
		catch (OperationCanceledException)
		{
			return;
		}

		showCopiedIndicator = false;
		await InvokeAsync(StateHasChanged);
	}

	public async ValueTask DisposeAsync()
	{
		copiedIndicatorCts?.Cancel();
		copiedIndicatorCts?.Dispose();

		if (module is null)
			return;

		try
		{
			await module.DisposeAsync();
		}
		catch (JSDisconnectedException)
		{
		}
	}
}
