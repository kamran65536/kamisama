@inject ToastService Toasts

@code {
    [Parameter] public Exception Exception { get; set; } = default!;
    private bool _shown;

    protected override void OnAfterRender(bool firstRender)
    {
        if (!_shown && Exception is not null)
        {
            _shown = true;

            Toasts.Notify(new ToastMessage
            {
            });
        }
    }
}
