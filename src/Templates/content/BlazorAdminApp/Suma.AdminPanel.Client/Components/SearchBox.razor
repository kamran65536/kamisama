<Card Class="mb-3 shadow-sm">
    <CardHeader>
        <CardTitle>@localizer[nameof(Resources.Search)]</CardTitle>
    </CardHeader>
    <CardBody>
        <div class="mb-2">
            @ChildContent
        </div>
        <div>
            <Button @onclick="OnSearchClicked" Color="ButtonColor.Primary">
                <Icon Name="IconName.Search" Size="IconSize.x5" />
                @localizer[nameof(Resources.Search)]
            </Button>
        </div>
    </CardBody>
</Card>

@code
{
    [Parameter]
    public EventCallback<MouseEventArgs> OnSearchClicked { get; set; }
    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}