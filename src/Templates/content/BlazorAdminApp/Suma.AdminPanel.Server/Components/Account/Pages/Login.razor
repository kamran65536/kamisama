@page "/Account/Login"

@using System.ComponentModel.DataAnnotations
@using Suma.AdminPanel.Properties
@using Microsoft.AspNetCore.Authentication
@using Microsoft.AspNetCore.Identity
@using Microsoft.Extensions.Localization

@inject SignInManager<ApplicationUser> SignInManager
@inject UserManager<ApplicationUser> UserManager
@inject ILogger<Login> Logger
@inject NavigationManager NavigationManager
@inject IdentityRedirectManager RedirectManager
@inject IStringLocalizer<Resources> localizer

<div class="mx-auto my-auto account-box">
    <Card Class="shadow">
        <CardHeader Class="text-center"><h3>@localizer[nameof(Resources.WelcomeBack)]</h3> </CardHeader>
        <CardBody>
            <StatusMessage Message="@errorMessage" />

            <EditForm Model="Input" method="post" OnValidSubmit="LoginUser" FormName="login">
                <ValidationSummary class="text-danger" role="alert" />
                <DataAnnotationsValidator />
                <div class="form-group">
                    <label class="form-label">@localizer[nameof(Resources.Email)]</label>
                    <InputText @bind-Value="Input.Email" id="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder=@localizer[nameof(Resources.Email)] />
                    <ValidationMessage For="() => Input.Email" class="text-danger" />
                </div>
                <div class="form-group mb-3">
                    <label class="form-label">@localizer[nameof(Resources.Password)]</label>
                    <InputText type="password" @bind-Value="Input.Password" id="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                    <ValidationMessage For="() => Input.Password" class="text-danger" />
                </div>
                <div class="checkbox mb-3">
                    <label class="form-label">
                        <InputCheckbox @bind-Value="Input.RememberMe" class="darker-border-checkbox form-check-input" />
                        Remember me
                    </label>
                </div>
                <div class="form-group">
                    <button class="btn btn-primary d-block w-100" type="submit">
                        @localizer[nameof(Resources.SignIn)]
                    </button>
                </div>
            </EditForm>
        </CardBody>
    </Card>
</div>

@code {
    private string? errorMessage;
    [CascadingParameter]
    private HttpContext HttpContext { get; set; } = default!;
    #pragma warning disable BL0008
    [SupplyParameterFromForm]
    public InputModel Input { get; set; } = new();
    #pragma warning restore BL0008

    [SupplyParameterFromQuery]
    private string? ReturnUrl { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (HttpMethods.IsGet(HttpContext.Request.Method))
        {
            // Clear the existing external cookie to ensure a clean login process
            await HttpContext.SignOutAsync(IdentityConstants.ExternalScheme);
        }
    }

    public async Task LoginUser()
    {
        errorMessage = "";
        Logger.LogInformation("Login attempt for {Username}.", Input.Email);

        try
        {
            // This doesn't count login failures towards account lockout
            // To enable password failures to trigger account lockout, set lockoutOnFailure: true
            var user = await UserManager.FindByEmailAsync(Input.Email) ?? await UserManager.FindByNameAsync(Input.Email);

            if (user == null)
            {
                errorMessage = "Invalid Login";
                Logger.LogWarning("Login failed because the user was not found for {Username}.", Input.Email);
                return;
            }

            var result = await SignInManager.PasswordSignInAsync(user, Input.Password, Input.RememberMe, lockoutOnFailure: false);
            if (result.Succeeded)
            {
                Logger.LogInformation("Login succeeded for {Username}.", user.UserName ?? Input.Email);
                RedirectManager.RedirectTo(ReturnUrl);
            }
            else if (result.RequiresTwoFactor)
            {
                Logger.LogInformation("Login requires two-factor authentication for {Username}.", user.UserName ?? Input.Email);
                RedirectManager.RedirectTo(
                    "Account/LoginWith2fa",
                    new() { ["returnUrl"] = ReturnUrl, ["rememberMe"] = Input.RememberMe });
            }
            else if (result.IsLockedOut)
            {
                Logger.LogWarning("Login failed because the account is locked out for {Username}.", user.UserName ?? Input.Email);
                RedirectManager.RedirectTo("Account/Lockout");
            }
            else
            {
                errorMessage = "Error: Invalid login attempt.";
                Logger.LogWarning("Login failed due to invalid credentials for {Username}.", user.UserName ?? Input.Email);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Login failed with an unexpected error for {Username}.", Input.Email);
            throw;
        }
    }

    public sealed class InputModel
    {
        [Required]
        [EmailAddress]
        public string Email { get; set; } = "";

        [Required]
        [DataType(DataType.Password)]
        public string Password { get; set; } = "";

        [Display(Name = "Remember me?")]
        public bool RememberMe { get; set; }
    }
}
