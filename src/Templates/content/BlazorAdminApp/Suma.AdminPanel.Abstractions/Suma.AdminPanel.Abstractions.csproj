<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<RootNamespace>Suma.AdminPanel</RootNamespace>
	</PropertyGroup>
	<!--#if (UseGlobalConfig)-->
	<Import Project="GlobalConfigPathPlaceholder" />
	<!--#else-->
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>
	<!--#endif-->
	<ItemGroup>
		<PackageReference Include="KamiSama.Chassis.Commons.Abstractions" Version="10.0.10" />
		<PackageReference Include="Microsoft.Extensions.Localization.Abstractions" Version="10.0.10" />
	</ItemGroup>
	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
	</ItemGroup>
	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>PublicResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>
</Project>
