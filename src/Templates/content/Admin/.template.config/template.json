{
  "$schema": "http://json.schemastore.org/template",
  "author": "KamiSama",
  "identity": "KamiSama.Templates.Admin",
  "name": "KamiSama Admin",
  "shortName": "kamisama-admin",
  "sourceName": "Example",
  "preferNameDirectory": true,
  "classifications": [ "Admin", "Blazor", "KamiSama" ],
  "tags": { "language": "C#", "type": "solution" },
  "symbols": {
    "UseProps": { "type": "parameter", "dataType": "bool", "defaultValue": "false" },
    "PropsPath": { "type": "parameter", "dataType": "string", "defaultValue": "../props.xml", "isEnabled": "UseProps", "replaces": "PropsPathToken" },
    "IncludeClient": { "type": "computed", "value": "true" },
    "IncludeServer": { "type": "computed", "value": "true" },
    "UserManagement": { "type": "parameter", "dataType": "bool", "defaultValue": "true", "description": "Include authorized user administration endpoints and UI." },
    "Ticketing": { "type": "parameter", "dataType": "bool", "defaultValue": "true", "description": "Include authorized ticket endpoints and UI." },
    "UserManagementProvider": { "type": "parameter", "dataType": "choice", "defaultValue": "Postgresql", "isEnabled": "(UserManagement || Ticketing)", "replaces": "UserManagementProviderToken", "choices": [ { "choice": "Postgresql" }, { "choice": "Sqlite" } ] },
    "TicketingProvider": { "type": "parameter", "dataType": "choice", "defaultValue": "Postgresql", "isEnabled": "Ticketing", "replaces": "TicketingProviderToken", "choices": [ { "choice": "Postgresql" }, { "choice": "Sqlite" } ] },
    "BootstrapMode": { "type": "parameter", "dataType": "choice", "defaultValue": "Create", "choices": [ { "choice": "Create" }, { "choice": "Existing" } ] },
    "BootstrapProject": { "type": "parameter", "dataType": "string", "defaultValue": "Example.Bootstrap/Example.Bootstrap.csproj", "isEnabled": "BootstrapMode == \"Existing\"", "description": "Explicit bootstrap project path relative to the generated solution root.", "replaces": "BootstrapProjectPathToken" }
  },
  "sources": [
    {
      "source": "../Orchestration",
      "target": "./",
      "exclude": [ ".template.config/**" ],
      "modifiers": [
        { "condition": "(!UserManagement)", "exclude": [ "**/Users/**", "Example.Abstractions/UserModels.cs" ] },
        { "condition": "(!Ticketing)", "exclude": [ "**/Tickets/**", "Example.Abstractions/TicketModels.cs" ] }
      ]
    },
    {
      "condition": "(BootstrapMode == \"Create\")",
      "source": "../Bootstrap",
      "target": "Example.Bootstrap",
      "exclude": [ ".template.config/**" ]
    },
    { "source": "../Shared/SolutionAi", "target": "./" }
  ]
}
