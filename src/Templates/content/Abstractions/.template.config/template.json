{
	"$schema": "http://json.schemastore.org/template",
	"author": "KamiSama",
	"classifications": [ "Common", "Code" ],
	"identity": "KamiSama.Projects.Abstractions",
	"name": "KamiSama Abstractions Project",
	"description": "KamiSama abstractions project with optional resources, data types, services, and exceptions folders.",
	"shortName": "kamisama-abstractions",
	"defaultName": "Example.Abstractions",
	"tags": {
		"language": "C#",
		"type": "project"
	},
	"sourceName": "Example.Abstractions",
	"symbols": {
		"UseGlobalProjectConfig": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "true",
			"displayName": "Use global project config",
			"description": "Use a shared project configuration file instead of per-project settings."
		},
		"GlobalProjectConfig": {
			"type": "parameter",
			"dataType": "string",
			"defaultValue": "../props.xml",
			"displayName": "Global project config",
			"description": "Path to the shared project configuration file.",
			"isEnabled": "UseGlobalProjectConfig",
			"replaces": "GlobalProjectConfigPath"
		},
		"MainNamespace": {
			"type": "generated",
			"generator": "regex",
			"dataType": "string",
			"replaces": "ExampleNamespace",
			"parameters": {
				"source": "name",
				"steps": [
					{
						"regex": "\\.Abstractions$",
						"replacement": ""
					},
					{
						"regex": "\\.Core$",
						"replacement": ""
					}
				]
			}
		},
		"IncludeResources": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "true",
			"displayName": "Resources.resx",
			"description": "Add Properties/Resources.resx with public resource code generation."
		},
		"IncludeDataTypes": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "true",
			"displayName": "DataTypes folder",
			"description": "Add the DataTypes folder."
		},
		"IncludeServices": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "true",
			"displayName": "Services folder",
			"description": "Add the Services folder."
		},
		"IncludeExceptions": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "true",
			"displayName": "Exceptions folder",
			"description": "Add the Exceptions folder."
		}
	},
	"sources": [
		{
			"modifiers": [
				{
					"condition": "(!IncludeResources)",
					"exclude": [
						"Properties/**"
					]
				},
				{
					"condition": "(!IncludeDataTypes)",
					"exclude": [
						"DataTypes/**"
					]
				},
				{
					"condition": "(!IncludeServices)",
					"exclude": [
						"Services/**"
					]
				},
				{
					"condition": "(!IncludeExceptions)",
					"exclude": [
						"Exceptions/**"
					]
				}
			]
		}
	]
}
