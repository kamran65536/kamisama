{
	"Logging": {
		"LogLevel": {
			"Default": "Information",
			"Microsoft.AspNetCore": "Warning",
			"Microsoft.EntityFrameworkCore": "Warning"
		}
	},
	"AllowedHosts": "*",
	"ConfigSection": {
		"initialization": {
			"migrate": true,
			"initialize": true,
			"test-data": true
		},
		"database": {
			"connectionString": "Data Source=./Data/db.sqlitedb;cache=shared",
			"provider": "sqlite"
		}
	}
}
