{
	"$schema": "http://json.schemastore.org/template",
	"author": "KamiSama",
	"classifications": [ "Common", "Code" ],
	"identity": "KamiSama.Projects.ApiServer",
	"name": "Api Server",
	"description": "KamiSama Api Server Project",
	"shortName": "kamisama-apiServer",
	"defaultName": "Example.ApiServer",
	"tags": {
		"language": "C#",
		"type": "project"
	},
	"sourceName": "Example.ApiServer",
	"symbols": {
		"ConfigSection": {
			"type": "parameter",
			"datatype": "text",
			"defaultValue": "ConfigSection",
			"displayName": "Config Section",
			"description": "the name of the config section in appsettings.json",
			"replaces": "ConfigSection",
			"fileRename": "ConfigSection",
			"isRequired": true
		},
		"BoundedContext": {
			"type": "parameter",
			"datatype": "text",
			"defaultValue": "BoundedContext",
			"displayName": "Bounded Context Name",
			"description": "the name of the context used in the project",
			"replaces": "BoundedContext",
			"fileRename": "BoundedContext",
			"isRequired": true
		},
		"AddSamples": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false",
			"displayName": "Sample Files",
			"description": "adds sample files to the project"
		},
		"UseSqlite": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false",
			"displayName": "Supports Sqlite",
			"description": "add sqlite dependencies to the project"
		},
		"UseSqlServer": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false",
			"displayName": "Supports SqlServer",
			"description": "add sqlserver dependencies to the project"
		},
		"UsePostgresql": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false",
			"displayName": "Supports Postgresql",
			"description": "add postgresql dependencies to the project"
		},
		"UseProps": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "true",
			"displayName": "Use prop.xml",
			"description": "use prop.xml to unify the process of library versioning"
		}
	},
	"sources": [
		{
			"modifiers": [
				{
					"condition": "(!AddSamples)",
					"exclude": [
						"Controllers/**",
					]
				},
				{
					"condition": "(!UseSqlServer)",
					"exclude": [
						"appsettings.SqlServer.json"
					]
				},
				{
					"condition": "(!UseSqlite)",
					"exclude": [
						"appsettings.Sqlite.json"
					]
				},
				{
					"condition": "(!UsePostgresql)",
					"exclude": [
						"appsettings.Postgresql.json"
					]
				}
			]
		}
	]
}
