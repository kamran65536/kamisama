{
	"$schema": "http://json.schemastore.org/template",
	"author": "KamiSama",
	"classifications": [ "Common", "Code" ],
	"identity": "KamiSama.Projects.BoundedContext.Abstractions",
	"name": "Bounded Context Abstractions",
	"description": "KamiSama Bounded Context Abstractions Project",
	"shortName": "kamisama-bca",
	"defaultName": "Example",
	"tags": {
		"language": "C#",
		"type": "project"
	},
	"sourceName": "Example",
	"symbols": {
		"AddSamples": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "false",
			"displayName": "Sample Files",
			"description": "adds sample files to the project"
		},
		"UseProps": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "true",
			"displayName": "Use prop.xml",
			"description": "use prop.xml to unify the process of library versioning"
		}
	},
	"sources": [
		{
			"modifiers": [
				{
					"condition": "(!AddSamples)",
					"exclude": [
						"SomeContext/**"
					]
				}
			]
		}
	]
}
