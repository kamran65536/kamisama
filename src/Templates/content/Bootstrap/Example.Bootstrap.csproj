<Project Sdk="Microsoft.NET.Sdk">
  <!--#if (UseProps)-->
  <Import Project="PropsPathToken" />
  <!--#else-->
  <PropertyGroup><TargetFramework>net10.0</TargetFramework><ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable></PropertyGroup>
  <!--#endif-->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="KamiSama.Modules" Version="10.0.11.7" />
    <!--#if (UserManagement || Ticketing)-->
    <PackageReference Include="KamiSama.Modules.Identity.Core" Version="10.0.11.7" />
    <!--#if (UserManagementProvider == "Postgresql")-->
    <PackageReference Include="KamiSama.Modules.Identity.Postgresql" Version="10.0.11.7" />
    <!--#else-->
    <PackageReference Include="KamiSama.Modules.Identity.Sqlite" Version="10.0.11.7" />
    <!--#endif-->
    <!--#endif-->
    <!--#if (Ticketing)-->
    <PackageReference Include="KamiSama.Modules.Ticketing.Core" Version="10.0.11.7" />
    <!--#if (TicketingProvider == "Postgresql")-->
    <PackageReference Include="KamiSama.Modules.Ticketing.Postgresql" Version="10.0.11.7" />
    <!--#else-->
    <PackageReference Include="KamiSama.Modules.Ticketing.Sqlite" Version="10.0.11.7" />
    <!--#endif-->
    <!--#endif-->
  </ItemGroup>
</Project>
