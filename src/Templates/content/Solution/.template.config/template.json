{
  "$schema": "http://json.schemastore.org/template",
  "author": "KamiSama",
  "identity": "KamiSama.Templates.Solution",
  "name": "KamiSama Solution",
  "shortName": "kamisama-solution",
  "sourceName": "Example",
  "preferNameDirectory": true,
  "classifications": [ "Solution", "KamiSama" ],
  "tags": { "language": "C#", "type": "solution" },
  "symbols": {
    "UseProps": { "type": "parameter", "dataType": "bool", "defaultValue": "false", "description": "Create a shared props.xml file." }
  },
  "sources": [
    {
      "source": "./",
      "modifiers": [ { "condition": "(!UseProps)", "exclude": [ "props.xml" ] } ]
    },
    { "source": "../Shared/SolutionAi", "target": "./" }
  ],
  "postActions": [ {
    "actionId": "AC1156F7-BB77-4DB8-B28F-24EEBCCA1E5C",
    "description": "Read the generated getting-started guide.",
    "continueOnError": true,
    "manualInstructions": [ { "text": "Open GETTING_STARTED.md before adding projects." } ]
  } ]
}
