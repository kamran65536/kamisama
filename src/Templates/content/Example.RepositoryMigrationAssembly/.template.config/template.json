{
	"$schema": "http://json.schemastore.org/template",
	"author": "KamiSama",
	"classifications": [ "Common", "Code" ],
	"identity": "KamiSama.Projects.MigrationAssembly",
	"name": "Repositories Migration Project",
	"description": "KamiSama Repository Migration Assembly",
	"shortName": "kamisama-migration-assembly",
	"defaultName": "Example.Repositories.Sqlite",
	"tags": {
		"language": "C#",
		"type": "project"
	},
	"sourceName": "Example.Repositories.Database",
	"symbols": {
		"BaseName": {
			"type": "parameter",
			"datatype": "text",
			"defaultValue": "Example",
			"displayName": "Base Context Name",
			"description": "Base name of project, eg. BaseName.Core",
			"replaces": "Example",
			"isRequired": true
		},
		"UseProps": {
			"type": "parameter",
			"dataType": "bool",
			"defaultValue": "true",
			"displayName": "Use prop.xml",
			"description": "use prop.xml to unify the process of library versioning"
		}
	}
}
