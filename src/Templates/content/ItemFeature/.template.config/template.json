{
  "$schema": "http://json.schemastore.org/template",
  "author": "KamiSama",
  "identity": "KamiSama.Templates.Item.Feature",
  "name": "KamiSama Single Feature Operation",
  "shortName": "kamisama-feature",
  "sourceName": "ItemName",
  "preferNameDirectory": false,
  "classifications": [ "C#", "Feature", "KamiSama" ],
  "tags": { "language": "C#", "type": "item" },
  "symbols": {
    "Operation": {
      "type": "parameter", "dataType": "choice", "defaultValue": "FindById",
      "choices": [ { "choice": "Add" }, { "choice": "Update" }, { "choice": "Delete" }, { "choice": "FindById" }, { "choice": "List" } ]
    },
    "Namespace": { "type": "parameter", "dataType": "string", "isRequired": true, "replaces": "NamespaceToken" },
    "ServiceCategory": { "type": "parameter", "dataType": "string", "isRequired": true, "replaces": "ServiceCategoryToken", "fileRename": "ServiceCategoryToken" },
    "KeyType": { "type": "parameter", "dataType": "string", "defaultValue": "Guid", "replaces": "KeyTypeToken" }
  },
  "sources": [
    { "source": "Add", "target": "Services", "condition": "(Operation == \"Add\")" },
    { "source": "Update", "target": "Services", "condition": "(Operation == \"Update\")" },
    { "source": "Delete", "target": "Services", "condition": "(Operation == \"Delete\")" },
    { "source": "FindById", "target": "Services", "condition": "(Operation == \"FindById\")" },
    { "source": "List", "target": "Services", "condition": "(Operation == \"List\")" }
  ]
}
