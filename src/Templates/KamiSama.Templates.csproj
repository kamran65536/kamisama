<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<PackageDocumentationRoot></PackageDocumentationRoot>
	</PropertyGroup>
	<Import Project="../props.xml" />
	<PropertyGroup>
		<PackageId>KamiSama.Templates</PackageId>
		<Title>KamiSama Project Templates</Title>
		<Description>Template-first .NET 10 solution design, bounded contexts, database providers, Bootstrap composition, Blazor servers, CRUD features, and Aspire development helpers for KamiSama.</Description>
		<PackageTags>KamiSama Templates Solution DDD BoundedContext EntityFrameworkCore Bootstrap Blazor CRUD Aspire AI</PackageTags>
		<Version>10.0.11.9</Version>
		<PackageType>Template</PackageType>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<IncludeContentInPack>true</IncludeContentInPack>
		<IncludeBuildOutput>false</IncludeBuildOutput>
		<ContentTargetFolders>content</ContentTargetFolders>
		<NoWarn>$(NoWarn);NU5128</NoWarn>
		<NoDefaultExcludes>true</NoDefaultExcludes>
		<LocalizeTemplates>false</LocalizeTemplates>
	</PropertyGroup>
	<ItemGroup>
		<!-- 7.0.120 is the latest published Microsoft.TemplateEngine.Tasks package and is intentionally pinned. -->
		<PackageReference Include="Microsoft.TemplateEngine.Tasks" Version="7.0.120" PrivateAssets="all" IsImplicitlyDefined="true" />
		<Content Include="content\**\*"
				 Exclude="content\**\bin\**;content\**\obj\**;content\Abstractions\**;content\BlazorAdminApp\**;content\Core\**;content\Database\**;content\Props\**"
				 Pack="true"
				 PackagePath="content" />
		<None Include="README.md" Pack="true" PackagePath="\" />
		<Compile Remove="**\*" />
		<EmbeddedResource Remove="content\**\*.resx" />
	</ItemGroup>
</Project>
