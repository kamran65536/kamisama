{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kamisama.dev/schemas/solution-design-v1.json",
  "title": "KamiSama modular solution design",
  "description": "High-level creation design and implemented solution-map format. C# remains authoritative for behavior.",
  "type": "object",
  "required": ["version"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "includes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "hints": { "$ref": "#/$defs/hints" },
    "solution": { "$ref": "#/$defs/solution" },
    "modules": {
      "type": "array",
      "items": { "$ref": "#/$defs/module" }
    },
    "bootstrap": { "$ref": "#/$defs/bootstrap" },
    "external-services": {
      "type": "array",
      "items": { "$ref": "#/$defs/externalService" }
    },
    "servers": {
      "type": "array",
      "items": { "$ref": "#/$defs/server" }
    }
  },
  "$defs": {
    "nonEmpty": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.-]*$" },
    "typeName": { "type": "string", "minLength": 1 },
    "stringMap": {
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "hints": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "namespace": { "type": "string" },
        "folder": { "type": "string" },
        "nullable": { "type": "boolean" },
        "implicit-usings": { "type": "boolean" },
        "prefer-templates": { "type": "boolean" },
        "preview": { "enum": ["concise", "normal", "detailed"] },
        "annotations": { "$ref": "#/$defs/stringMap" }
      }
    },
    "solution": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "root": { "type": "string", "minLength": 1 },
        "solution-file": { "type": "string", "pattern": "\\.slnx$" },
        "create-directory": { "type": "boolean" },
        "use-props": { "type": "boolean" },
        "target-framework": { "type": "string", "pattern": "^net[0-9]+\\.[0-9]+$" },
        "hints": { "$ref": "#/$defs/hints" }
      }
    },
    "module": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["bounded-context", "panel", "infrastructure", "library"] },
        "path": { "type": "string" },
        "projects": { "type": "array", "items": { "$ref": "#/$defs/project" } },
        "references": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "providers": { "type": "array", "items": { "$ref": "#/$defs/provider" } },
        "data-types": { "type": "array", "items": { "$ref": "#/$defs/dataType" } },
        "entities": { "type": "array", "items": { "$ref": "#/$defs/entity" } },
        "services": { "type": "array", "items": { "$ref": "#/$defs/service" } },
        "apis": { "type": "array", "items": { "$ref": "#/$defs/api" } },
        "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } },
        "inferred": { "type": "boolean" },
        "hints": { "$ref": "#/$defs/hints" }
      }
    },
    "project": {
      "type": "object",
      "required": ["name", "role"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "role": { "enum": ["abstractions", "core", "provider", "bootstrap", "client", "server", "worker", "apphost", "library", "tests"] },
        "path": { "type": "string" },
        "references": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "packages": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "uniqueItems": true },
        "inferred": { "type": "boolean" }
      }
    },
    "provider": {
      "type": "object",
      "required": ["name", "provider"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "provider": { "enum": ["Postgresql", "Sqlite", "SqlServer", "Oracle"] },
        "project": { "$ref": "#/$defs/name" },
        "connection": { "$ref": "#/$defs/nonEmpty" },
        "migrations": { "type": "boolean" },
        "initialize": { "type": "boolean" },
        "inferred": { "type": "boolean" }
      }
    },
    "dataType": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["enum", "value-object", "record"] },
        "underlying-type": { "$ref": "#/$defs/typeName" },
        "members": { "type": "array", "items": { "$ref": "#/$defs/enumMember" } },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } },
        "inferred": { "type": "boolean" },
        "hints": { "$ref": "#/$defs/hints" }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "enum" } }, "required": ["kind"] },
          "then": { "properties": { "members": true }, "required": ["members"] }
        }
      ]
    },
    "enumMember": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "value": { "type": "integer" },
        "label": { "type": "string" }
      }
    },
    "property": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "$ref": "#/$defs/typeName" },
        "nullable": { "type": "boolean" },
        "collection": { "type": "boolean" },
        "key": { "type": "boolean" },
        "searchable": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "editable": { "type": "boolean" },
        "default": {},
        "inferred": { "type": "boolean" },
        "hints": { "$ref": "#/$defs/hints" }
      }
    },
    "entity": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "key-type": { "$ref": "#/$defs/typeName" },
        "properties": { "type": "array", "items": { "$ref": "#/$defs/property" } },
        "crud": { "$ref": "#/$defs/crud" },
        "repository": { "$ref": "#/$defs/repository" },
        "inferred": { "type": "boolean" },
        "hints": { "$ref": "#/$defs/hints" }
      }
    },
    "crud": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operations": {
          "type": "array",
          "items": { "enum": ["add", "update", "delete", "find-by-id", "list"] },
          "uniqueItems": true
        },
        "service-category": { "$ref": "#/$defs/name" },
        "list-item-type": { "$ref": "#/$defs/typeName" },
        "dto-type": { "$ref": "#/$defs/typeName" },
        "search-model": { "$ref": "#/$defs/typeName" },
        "name-lookup": { "type": "boolean" },
        "inferred": { "type": "boolean" }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "search-model": { "$ref": "#/$defs/typeName" },
        "lookup-by-name": { "type": "boolean" },
        "inferred": { "type": "boolean" }
      }
    },
    "service": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["command", "query", "crud", "orchestration", "hosted-service", "external-client"] },
        "operation": { "enum": ["add", "update", "delete", "find-by-id", "list", "custom"] },
        "contract": { "$ref": "#/$defs/typeName" },
        "input": { "$ref": "#/$defs/typeName" },
        "output": { "$ref": "#/$defs/typeName" },
        "key-type": { "$ref": "#/$defs/typeName" },
        "calls": { "type": "array", "items": { "$ref": "#/$defs/nonEmpty" }, "uniqueItems": true },
        "transaction": { "enum": ["none", "local", "orchestrated", "unspecified"] },
        "schedule": { "type": "array", "items": { "$ref": "#/$defs/scheduleWindow" } },
        "inferred": { "type": "boolean" },
        "hints": { "$ref": "#/$defs/hints" }
      }
    },
    "scheduleWindow": {
      "type": "object",
      "required": ["name", "timezone", "start", "end"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "timezone": { "$ref": "#/$defs/nonEmpty" },
        "start": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "end": { "type": "string", "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$" },
        "weekdays": {
          "type": "array",
          "items": { "enum": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"] },
          "uniqueItems": true
        },
        "interval": { "type": "string", "pattern": "^P(?!$).+" },
        "allow-overlap": { "type": "boolean" }
      }
    },
    "bootstrap": {
      "type": "object",
      "required": ["project"],
      "additionalProperties": false,
      "properties": {
        "project": { "$ref": "#/$defs/name" },
        "path": { "type": "string" },
        "registrations": { "type": "array", "items": { "$ref": "#/$defs/registration" } },
        "references": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "hints": { "$ref": "#/$defs/hints" }
      }
    },
    "registration": {
      "type": "object",
      "required": ["module"],
      "additionalProperties": false,
      "properties": {
        "module": { "$ref": "#/$defs/name" },
        "provider": { "$ref": "#/$defs/name" },
        "enabled": { "type": "boolean" },
        "options": { "$ref": "#/$defs/stringMap" },
        "inferred": { "type": "boolean" }
      }
    },
    "externalService": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["http", "grpc", "database", "queue", "cache", "storage", "smtp", "other"] },
        "base-url-setting": { "$ref": "#/$defs/nonEmpty" },
        "connection-setting": { "$ref": "#/$defs/nonEmpty" },
        "client-contract": { "$ref": "#/$defs/typeName" },
        "owner": { "$ref": "#/$defs/name" },
        "required-by": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "health-check": { "type": "boolean" },
        "inferred": { "type": "boolean" },
        "hints": { "$ref": "#/$defs/hints" }
      }
    },
    "server": {
      "type": "object",
      "required": ["name", "kind", "project"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["web", "worker", "daemon", "panel", "apphost"] },
        "project": { "$ref": "#/$defs/name" },
        "path": { "type": "string" },
        "references": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "modules": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "services": { "type": "array", "items": { "$ref": "#/$defs/service" } },
        "apis": { "type": "array", "items": { "$ref": "#/$defs/api" } },
        "pages": { "type": "array", "items": { "$ref": "#/$defs/page" } },
        "resources": { "type": "array", "items": { "$ref": "#/$defs/resource" } },
        "authentication": { "enum": ["none", "identity", "jwt", "cookie", "external", "existing"] },
        "authorization": { "$ref": "#/$defs/nonEmpty" },
        "inferred": { "type": "boolean" },
        "hints": { "$ref": "#/$defs/hints" }
      }
    },
    "resource": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["project", "postgresql", "sqlite", "sqlserver", "oracle", "container", "external"] },
        "reference": { "$ref": "#/$defs/nonEmpty" },
        "depends-on": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "wait-for": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true },
        "migrate": { "type": "boolean" },
        "initialize": { "type": "boolean" },
        "development-password": { "type": "string" },
        "inferred": { "type": "boolean" }
      }
    },
    "api": {
      "type": "object",
      "required": ["name", "route", "endpoints"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "route": { "type": "string", "pattern": "^/" },
        "authorization": { "$ref": "#/$defs/nonEmpty" },
        "endpoints": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/endpoint" } },
        "inferred": { "type": "boolean" }
      }
    },
    "endpoint": {
      "type": "object",
      "required": ["operation", "method", "route", "service"],
      "additionalProperties": false,
      "properties": {
        "operation": { "$ref": "#/$defs/name" },
        "method": { "enum": ["GET", "POST", "PUT", "PATCH", "DELETE"] },
        "route": { "type": "string" },
        "service": { "$ref": "#/$defs/nonEmpty" },
        "request": { "$ref": "#/$defs/typeName" },
        "response": { "$ref": "#/$defs/typeName" },
        "authorization": { "$ref": "#/$defs/nonEmpty" },
        "paged": { "type": "boolean" },
        "inferred": { "type": "boolean" }
      }
    },
    "page": {
      "type": "object",
      "required": ["name", "route", "kind", "content"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "route": { "type": "string", "pattern": "^/" },
        "kind": { "enum": ["list", "details", "save", "dashboard", "custom"] },
        "entity": { "$ref": "#/$defs/name" },
        "service": { "$ref": "#/$defs/nonEmpty" },
        "authorization": { "$ref": "#/$defs/nonEmpty" },
        "parameters": { "type": "array", "items": { "$ref": "#/$defs/parameter" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "content": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/content" } },
        "inferred": { "type": "boolean" },
        "hints": { "$ref": "#/$defs/hints" }
      }
    },
    "parameter": {
      "type": "object",
      "required": ["name", "type"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "type": { "$ref": "#/$defs/typeName" },
        "optional": { "type": "boolean" },
        "source": { "enum": ["route", "query", "form", "state"] }
      }
    },
    "action": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["add", "view", "edit", "delete", "submit", "command", "navigate", "refresh"] },
        "label": { "type": "string" },
        "service": { "$ref": "#/$defs/nonEmpty" },
        "route": { "type": "string" },
        "confirm": { "type": "boolean" },
        "refresh": { "type": "boolean" },
        "requires": { "$ref": "#/$defs/nonEmpty" },
        "inferred": { "type": "boolean" }
      }
    },
    "field": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "label": { "type": "string" },
        "type": { "$ref": "#/$defs/typeName" },
        "binding": { "$ref": "#/$defs/nonEmpty" },
        "visible": { "type": "boolean" },
        "editable": { "type": "boolean" },
        "required": { "type": "boolean" },
        "control": { "enum": ["text", "number", "select", "checkbox", "date", "time", "datetime", "textarea", "hidden", "display"] },
        "options-source": { "$ref": "#/$defs/nonEmpty" },
        "inferred": { "type": "boolean" }
      }
    },
    "column": {
      "type": "object",
      "required": ["name", "binding"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "binding": { "$ref": "#/$defs/nonEmpty" },
        "label": { "type": "string" },
        "sortable": { "type": "boolean" },
        "visible": { "type": "boolean" },
        "format": { "type": "string" },
        "inferred": { "type": "boolean" }
      }
    },
    "content": {
      "type": "object",
      "required": ["kind"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/name" },
        "kind": { "enum": ["section", "text", "field", "form", "grid", "search", "actions", "component", "tabs", "tab", "details", "empty-state", "validation-summary"] },
        "title": { "type": "string" },
        "text": { "type": "string" },
        "component": { "$ref": "#/$defs/typeName" },
        "binding": { "$ref": "#/$defs/nonEmpty" },
        "service": { "$ref": "#/$defs/nonEmpty" },
        "paged": { "type": "boolean" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/field" } },
        "columns": { "type": "array", "items": { "$ref": "#/$defs/column" } },
        "actions": { "type": "array", "items": { "$ref": "#/$defs/action" } },
        "content": { "type": "array", "items": { "$ref": "#/$defs/content" } },
        "inferred": { "type": "boolean" },
        "hints": { "$ref": "#/$defs/hints" }
      }
    }
  }
}
